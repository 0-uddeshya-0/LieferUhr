# Production stack env — copy to .env.prod and fill in. Never commit .env.prod.

# Postgres password used by docker-compose.prod.yml (db service + DATABASE_URL)
DB_PASSWORD="generate-a-long-random-string"

# JWT
JWT_SECRET="generate-a-random-64-char-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# Email (SMTP) — your transactional mail provider
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM_NAME="Lieferuhr"
EMAIL_FROM_ADDRESS="noreply@your-domain.de"

# Public URLs — the site domain that terminates TLS (Caddy/Traefik in front)
# Both products share the origin: Einkauf at /, FrachtRadar at /fleet/, API at /api.
API_URL="https://app.your-domain.de/api"
WEB_URL="https://app.your-domain.de"
FLEET_URL="https://app.your-domain.de/fleet"

# Environment
NODE_ENV="production"
PORT="3001"

# Storage for POD photos + generated invoices (container volume)
UPLOAD_DIR="./uploads"

# Cron (defaults are fine)
REMINDER_CRON="0 * * * *"
DIGEST_CRON="0 8 * * 1"
FLEET_PING_CRON="15 * * * *"

# Host port the site listens on (default 8080)
# HTTP_PORT="8080"
