generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  RECEIVED
  IN_PROGRESS
  SHIPPED
  DELAYED
  DELIVERED
  CANCELLED
}

enum ReminderType {
  INITIAL
  REMINDER_1
  REMINDER_2
  MANUAL
}

enum LoadStatus {
  NEW
  DISPATCHED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  INVOICED
  CANCELLED
}

enum InvoiceStatus {
  ISSUED
  PAID
}

model Organization {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  webhookUrl         String?
  webhookSecret      String?
  street             String?
  zip                String?
  city               String?
  taxId              String?
  invoicePrefix      String     @default("RE-")
  nextInvoiceNumber  Int        @default(1)
  createdAt          DateTime   @default(now())
  users              User[]
  suppliers          Supplier[]
  orders             Order[]
  apiKeys            ApiKey[]
  invites            Invite[]
  fleetCustomers     FleetCustomer[]
  drivers            Driver[]
  vehicles           Vehicle[]
  loads              Load[]
  invoices           Invoice[]
}

model ApiKey {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String       @unique
  createdAt    DateTime     @default(now())
  lastUsedAt   DateTime?

  @@index([orgId])
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  orgId         String
  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Supplier {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  contactEmail String
  contactName  String?
  notes        String?
  createdAt    DateTime     @default(now())
  orders       Order[]
}

model Order {
  id                 String       @id @default(cuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderNumber        String
  partDescription    String
  quantity           Int?
  unit               String?
  valueCents         Int?
  dueDate            DateTime
  confirmedDate      DateTime?
  status             OrderStatus  @default(PENDING)
  statusNote         String?
  magicToken         String       @unique @default(nanoid(32))
  lastSupplierUpdate DateTime?
  lastReminderSent   DateTime?
  reminderCount      Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  events             OrderEvent[]
  reminders          Reminder[]

  @@index([orgId])
  @@index([supplierId])
  @@index([status])
  @@index([dueDate])
}

model Invite {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String
  token        String       @unique @default(nanoid(32))
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  source    String
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Reminder {
  id      String       @id @default(cuid())
  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    ReminderType
  sentAt  DateTime     @default(now())
  emailTo String

  @@index([orderId])
}

model FleetCustomer {
  id           String       @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  contactName  String?
  contactEmail String?
  address      String?
  notes        String?
  createdAt    DateTime     @default(now())
  loads        Load[]

  @@index([orgId])
}

model Driver {
  id                String       @id @default(cuid())
  orgId             String
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  phone             String?
  email             String?
  licenseValidUntil DateTime?
  notes             String?
  createdAt         DateTime     @default(now())
  loads             Load[]

  @@index([orgId])
}

model Vehicle {
  id               String       @id @default(cuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plate            String
  type             String?
  nextInspectionAt DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  loads            Load[]

  @@index([orgId])
}

model Load {
  id               String       @id @default(cuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  loadNumber       String
  customerId       String
  customer         FleetCustomer @relation(fields: [customerId], references: [id])
  driverId         String?
  driver           Driver?      @relation(fields: [driverId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id])
  pickupAddress    String
  pickupAt         DateTime
  pickupUntil      DateTime?
  deliveryAddress  String
  deliveryAt       DateTime
  deliveryUntil    DateTime?
  cargoDescription String
  weightKg         Int?
  pallets          Int?
  priceCents       Int?
  status           LoadStatus   @default(NEW)
  statusNote       String?
  notes            String?
  driverToken      String       @unique @default(nanoid(32))
  trackingToken    String       @unique @default(nanoid(32))
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  lastDriverUpdate DateTime?
  lastDriverPing   DateTime?
  trackingSentAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  events           LoadEvent[]
  pods             PodUpload[]
  invoice          Invoice?

  @@index([orgId])
  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([pickupAt])
}

model LoadEvent {
  id        String      @id @default(cuid())
  loadId    String
  load      Load        @relation(fields: [loadId], references: [id], onDelete: Cascade)
  status    LoadStatus
  note      String?
  source    String
  createdAt DateTime    @default(now())

  @@index([loadId])
}

model PodUpload {
  id         String   @id @default(cuid())
  loadId     String
  load       Load     @relation(fields: [loadId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  mimeType   String
  note       String?
  uploadedBy String   @default("driver")
  createdAt  DateTime @default(now())

  @@index([loadId])
}

model Invoice {
  id            String        @id @default(cuid())
  orgId         String
  organization  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  loadId        String        @unique
  load          Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  invoiceNumber String
  buyerName     String
  buyerAddress  String?
  netCents      Int
  taxRateBps    Int           @default(1900)
  grossCents    Int
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  pdfPath       String?
  createdAt     DateTime      @default(now())

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
}
